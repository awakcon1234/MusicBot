#: musicbot/aliases.py:56
msgid ""
"Error while loading aliases.\n"
"\n"
"Problem:\n"
"  Your aliases files (aliases.json & example_aliases.json) are missing.\n"
"\n"
"Solution:\n"
"  Replace the alias config file(s) or copy them from:\n"
"    https://github.com/Just-Some-Bots/MusicBot/"
msgstr ""
"Lỗi khi tải bí danh.\n"
"\n"
"Vấn đề:\n"
"Tệp bí danh của bạn (aliases.json & example_aliases.json) bị thiếu.\n"
"\n"
"Giải pháp:\n"
"Thay thế tệp cấu hình bí danh hoặc sao chép chúng từ:\n"
"https://github.com/Just-Some-Bots/MusicBot/"

#: musicbot/bot.py:732
msgid "Member is not voice-enabled and cannot use this command."
msgstr "Thành viên không được kích hoạt giọng nói và không thể sử dụng lệnh này."

#: musicbot/bot.py:740
msgid "You cannot use this command when not in the voice channel."
msgstr "Bạn không thể sử dụng lệnh này khi không ở trong kênh giọng nói."

#: musicbot/bot.py:783
#, python-format
msgid "MusicBot does not have permission to Connect in channel:  `%(name)s`"
msgstr "MusicBot không có quyền kết nối trong kênh:  `%(name)s`"

#: musicbot/bot.py:792
#, python-format
msgid "MusicBot does not have permission to Speak in channel:  `%(name)s`"
msgstr "MusicBot không có quyền nói trong kênh:  `%(name)s`"

#: musicbot/bot.py:825
msgid ""
"MusicBot could not connect to the channel.\n"
"Try again later, or restart the bot if this continues."
msgstr ""
"MusicBot không thể kết nối với kênh.\n"
"Hãy thử lại sau, hoặc khởi động lại bot nếu điều này tiếp tục xảy ra."

#: musicbot/bot.py:849
msgid "MusicBot connection to voice was cancelled. This is odd. Maybe restart?"
msgstr "Kết nối MusicBot với giọng nói đã bị hủy. Điều này thật kỳ lạ. Có thể khởi động lại?"

#: musicbot/bot.py:860
msgid "MusicBot does not have permission to speak."
msgstr "MusicBot không có quyền nói."

#: musicbot/bot.py:864
msgid "MusicBot could not request to speak."
msgstr "MusicBot không thể yêu cầu nói."

#: musicbot/bot.py:1036
msgid ""
"The bot is not in a voice channel.\n"
"Use the summon command to bring the bot to your voice channel."
msgstr ""
"Bot không ở trong một kênh giọng nói.\n"
"Sử dụng lệnh triệu hồi để đưa bot đến kênh giọng nói của bạn."

#: musicbot/bot.py:1048
msgid "Something is wrong, we didn't get the VoiceClient."
msgstr "Có điều gì đó không ổn, chúng tôi không nhận được VoiceClient."

#: musicbot/bot.py:1104
#, python-format
msgid "Skipping next song `%(title)s` as requester `%(user)s` is not in voice!"
msgstr "Bỏ qua bài hát tiếp theo `%(title)s` vì người yêu cầu `%(user)s` không ở trong giọng nói!"

#: musicbot/bot.py:1122
#, python-format
msgid "%(mention)s - your song `%(title)s` is now playing in %(channel)s!"
msgstr "%(mention)s - bài hát của bạn `%(title)s` hiện đang phát trong %(channel)s!"

#: musicbot/bot.py:1131
#, python-format
msgid "Now playing in %(channel)s: `%(title)s` added by %(author)s!"
msgstr "Hiện đang phát trong %(channel)s: `%(title)s` được thêm bởi %(author)s!"

#: musicbot/bot.py:1142
#, python-format
msgid "Now playing automatically added entry `%(title)s` in %(channel)s!"
msgstr "Hiện đang phát mục tự động thêm `%(title)s` trong %(channel)s!"

#: musicbot/bot.py:1353
#, python-format
msgid "Skipping songs added by %(user)s as they are not in voice!"
msgstr "Bỏ qua các bài hát được thêm bởi %(user)s vì họ không ở trong giọng nói!"

#: musicbot/bot.py:1575
#, python-format
msgid ""
"Playback failed for song `%(song)s` due to an error:\n"
"```\n"
"%(error)s```"
msgstr ""
"Phát lại thất bại cho bài hát `%(song)s` do lỗi:\n"
"```\n"
"%(error)s```"

#: musicbot/bot.py:1827
msgid "[Dev Bug] Tried sending an invalid response object."
msgstr "[Lỗi Dev] Đã cố gắng gửi một đối tượng phản hồi không hợp lệ."

#: musicbot/bot.py:2178
msgid ""
"Failed Discord API Login!\n"
"\n"
"Problem:\n"
"  MusicBot could not log into Discord API.\n"
"  Your Token may be incorrect or there may be an API outage.\n"
"\n"
"Solution:\n"
"  Make sure you have the correct Token set in your config.\n"
"  Check API status at the official site: discordstatus.com"
msgstr ""
"Đăng nhập Discord API thất bại!\n"
"\n"
"Vấn đề:\n"
"  MusicBot không thể đăng nhập vào Discord API.\n"
"  Token của bạn có thể không chính xác hoặc có thể có sự cố API.\n"
"\n"
"Giải pháp:\n"
"  Đảm bảo bạn đã đặt Token chính xác trong cấu hình của mình.\n"
"  Kiểm tra trạng thái API tại trang chính thức: discordstatus.com"

#: musicbot/bot.py:2789
#, python-format
msgid "The requested song `%(subject)s` is blocked by the song block list."
msgstr "Bài hát yêu cầu `%(subject)s` bị chặn bởi danh sách chặn bài hát."

#: musicbot/bot.py:2925
msgid ""
"Reset the auto playlist queue by copying it back into player memory.\n"
"This command will be removed in a future version, replaced by the autoplaylist command(s)."
msgstr ""
"Đặt lại hàng đợi danh sách phát tự động bằng cách sao chép lại vào bộ nhớ của trình phát.\n"
"Lệnh này sẽ bị xóa trong phiên bản tương lai, được thay thế bằng lệnh danh sách phát tự động."

#: musicbot/bot.py:2940
msgid "\\N{OK HAND SIGN}"
msgstr "\\N{OK HAND SIGN}"

#: musicbot/bot.py:2947
msgid "Show usage and description of a command, or list all available commands.\n"
msgstr "Hiển thị cách sử dụng và mô tả của một lệnh, hoặc liệt kê tất cả các lệnh có sẵn.\n"

#: musicbot/bot.py:2978
msgid "**Aliases for this command:**\n"
msgstr "**Biệt danh cho lệnh này:**\n"

#: musicbot/bot.py:2981
#, python-format
msgid "`%(alias)s` alias of `%(command)s %(args)s`\n"
msgstr "`%(alias)s` biệt danh của `%(command)s %(args)s`\n"

#: musicbot/bot.py:3014
#, python-format
msgid ""
"**Alias of command:**\n"
"  `%(command)s`\n"
msgstr ""
"**Biệt danh của lệnh:**\n"
"  `%(command)s`\n"

#. TRANSLATORS: template string for command-specific help output.
#: musicbot/bot.py:3021
#, python-format
msgid ""
"%(is_alias)s\n"
"%(docs)s\n"
"%(alias_list)s"
msgstr ""
"%(is_alias)s\n"
"%(docs)s\n"
"%(alias_list)s"

#: musicbot/bot.py:3030
msgid "No such command"
msgstr "Không có lệnh như vậy"

#: musicbot/bot.py:3049
#, python-format
msgid ""
"The list above shows only commands permitted for your use.\n"
"For a list of all commands, run: %(example_all)s\n"
msgstr ""
"Danh sách trên chỉ hiển thị các lệnh được phép sử dụng của bạn.\n"
"Để có danh sách tất cả các lệnh, hãy chạy: %(example_all)s\n"

#: musicbot/bot.py:3055
#, python-format
msgid ""
"**Commands by name:** *(without prefix)*\n"
"```\n"
"%(command_list)s\n"
"```\n"
"**Command Prefix:** %(prefix)s\n"
"\n"
"For help with a particular command, run: %(example_command)s\n"
"%(all_note)s"
msgstr ""
"**Lệnh theo tên:** *(không có tiền tố)*\n"
"```\n"
"%(command_list)s\n"
"```\n"
"**Tiền tố lệnh:** %(prefix)s\n"
"\n"
"Để được trợ giúp với một lệnh cụ thể, hãy chạy: %(example_command)s\n"
"%(all_note)s"

#: musicbot/bot.py:3074
msgid "    Block a mentioned user."
msgstr "    Chặn một người dùng đã được đề cập."

#: musicbot/bot.py:3077
msgid "    Unblock a mentioned user."
msgstr "    Bỏ chặn một người dùng đã được đề cập."

#: musicbot/bot.py:3080
msgid "    Show the block status of a mentioned user."
msgstr "    Hiển thị trạng thái chặn của một người dùng đã được đề cập."

#: musicbot/bot.py:3084
msgid ""
"Manage the users in the user block list.\n"
"Blocked users are forbidden from using all bot commands.\n"
msgstr ""
"Quản lý người dùng trong danh sách chặn.\n"
"Người dùng bị chặn không được sử dụng tất cả các lệnh của bot.\n"

#: musicbot/bot.py:3106
msgid "You must mention a user or provide their ID number."
msgstr "Bạn phải đề cập đến một người dùng hoặc cung cấp số ID của họ."

#: musicbot/bot.py:3111
msgid "Invalid sub-command given. Use `help blockuser` for usage examples."
msgstr "Lệnh phụ không hợp lệ. Sử dụng `help blockuser` để biết ví dụ sử dụng."

#: musicbot/bot.py:3122
msgid "MusicBot could not find the user(s) you specified."
msgstr "MusicBot không thể tìm thấy người dùng mà bạn đã chỉ định."

#: musicbot/bot.py:3129
msgid "The owner cannot be added to the block list."
msgstr "Chủ sở hữu không thể được thêm vào danh sách chặn."

#: musicbot/bot.py:3149
msgid "User block list is currently enabled."
msgstr "Danh sách chặn người dùng hiện đang được bật."

#: musicbot/bot.py:3151
msgid "User block list is currently disabled."
msgstr "Danh sách chặn người dùng hiện đang bị tắt."

#: musicbot/bot.py:3159
msgid "Cannot add the users you listed, they are already added."
msgstr "Không thể thêm những người dùng bạn đã liệt kê, họ đã được thêm vào rồi."

#: musicbot/bot.py:3168
#, python-format
msgid ""
"%(number)s user(s) have been added to the block list.\n"
"%(status)s"
msgstr ""
"%(number)s người dùng đã được thêm vào danh sách chặn.\n"
"%(status)s"

#: musicbot/bot.py:3179
msgid "None of those users are in the blacklist."
msgstr "Không có người dùng nào trong danh sách đen đó."

#: musicbot/bot.py:3184
#, python-format
msgid "User: `%(user)s` is not blocked.\n"
msgstr "Người dùng: `%(user)s` không bị chặn.\n"

#: musicbot/bot.py:3186
#, python-format
msgid "User: `%(user)s` is blocked.\n"
msgstr "Người dùng: `%(user)s` đã bị chặn.\n"

#: musicbot/bot.py:3189
#, python-format
msgid ""
"**Block list status:**\n"
"%(status)s\n"
"%(users)s"
msgstr ""
"**Trạng thái danh sách chặn:**\n"
"%(status)s\n"
"%(users)s"

#: musicbot/bot.py:3199
#, python-format
msgid ""
"%(number)s user(s) have been removed from the block list.\n"
"%(status)s"
msgstr ""
"%(number)s người dùng đã được gỡ bỏ khỏi danh sách chặn.\n"
"%(status)s"

#: musicbot/bot.py:3208
msgid ""
"Manage a block list applied to song requests and extracted song data.\n"
"A subject may be a song URL or a word or phrase found in the track title.\n"
"If subject is omitted, any currently playing track URL will be added instead.\n"
"\n"
"The song block list matches loosely, but is case-sensitive.\n"
"This means adding 'Pie' will match 'cherry Pie' but not 'piecrust' in checks.\n"
msgstr ""
"Quản lý danh sách chặn áp dụng cho yêu cầu bài hát và dữ liệu bài hát đã trích xuất.\n"
"Một chủ đề có thể là URL bài hát hoặc một từ hoặc cụm từ có trong tiêu đề bài hát.\n"
"Nếu chủ đề bị bỏ qua, bất kỳ URL bài hát nào đang phát sẽ được thêm vào thay thế.\n"
"\n"
"Danh sách chặn bài hát khớp lỏng lẻo, nhưng phân biệt chữ hoa chữ thường.\n"
"Điều này có nghĩa là thêm 'Pie' sẽ khớp với 'cherry Pie' nhưng không khớp với 'piecrust' trong các kiểm tra.\n"

#: musicbot/bot.py:3236
msgid "You must provide a song subject if no song is currently playing."
msgstr "Bạn phải cung cấp một chủ đề bài hát nếu không có bài hát nào đang phát."

#: musicbot/bot.py:3242
msgid "Invalid sub-command given. Use `help blocksong` for usage examples."
msgstr "Lệnh phụ không hợp lệ. Sử dụng `help blocksong` để biết ví dụ sử dụng."

#: musicbot/bot.py:3254
#, python-format
msgid "Subject `%(subject)s` is already in the song block list."
msgstr "Chủ đề `%(subject)s` đã có trong danh sách chặn bài hát."

#: musicbot/bot.py:3277
#, python-format
msgid ""
"Added subject `%(subject)s` to the song block list.\n"
"%(status)s"
msgstr ""
"Đã thêm chủ đề `%(subject)s` vào danh sách chặn bài hát.\n"
"%(status)s"

#: musicbot/bot.py:3286
msgid "The subject is not in the song block list and cannot be removed."
msgstr "Chủ đề không có trong danh sách chặn bài hát và không thể bị gỡ bỏ."

#: musicbot/bot.py:3294
#, python-format
msgid ""
"Subject `%(subject)s` has been removed from the block list.\n"
"%(status)s"
msgstr ""
"Chủ đề `%(subject)s` đã được gỡ bỏ khỏi danh sách chặn.\n"
"%(status)s"

#: musicbot/bot.py:3304
msgid "    Adds or removes the specified song or currently playing song to/from the current playlist.\n"
msgstr "    Thêm hoặc gỡ bỏ bài hát đã chỉ định hoặc bài hát đang phát hiện tại khỏi/danh sách phát hiện tại.\n"

#: musicbot/bot.py:3307
msgid "    Adds the entire queue to the guilds playlist.\n"
msgstr "    Thêm toàn bộ hàng đợi vào danh sách phát của guild.\n"

#: musicbot/bot.py:3311
msgid ""
"    Clear all songs from the named playlist file.\n"
"    If name is omitted, the currently loaded playlist is emptied.\n"
msgstr ""
"    Xóa tất cả bài hát khỏi tệp danh sách phát đã đặt tên.\n"
"    Nếu tên bị bỏ qua, danh sách phát hiện đang được tải sẽ bị xóa.\n"

#: musicbot/bot.py:3316
msgid "    Show the currently selected playlist and a list of existing playlist files.\n"
msgstr "    Hiển thị danh sách phát hiện đang được chọn và danh sách các tệp danh sách phát hiện có.\n"

#: musicbot/bot.py:3320
msgid "    Reload the auto playlist queue, restarting at the first track unless randomized.\n"
msgstr "    Tải lại hàng đợi danh sách phát tự động, bắt đầu từ bài hát đầu tiên trừ khi được ngẫu nhiên hóa.\n"

#: musicbot/bot.py:3324
msgid "    Set a playlist as default for this guild and reloads the guild auto playlist.\n"
msgstr "    Đặt một danh sách phát làm mặc định cho guild này và tải lại danh sách phát tự động của guild.\n"

#: musicbot/bot.py:3328
msgid "Manage auto playlist files and per-guild settings."
msgstr "Quản lý tệp danh sách phát tự động và cài đặt theo từng máy chủ."

#: musicbot/bot.py:3358
msgid "Invalid sub-command given. Use `help autoplaylist` for usage examples."
msgstr "Lệnh phụ không hợp lệ được cung cấp. Sử dụng `help autoplaylist` để biết ví dụ sử dụng."

#: musicbot/bot.py:3365
msgid "The supplied song link is invalid"
msgstr "Liên kết bài hát được cung cấp không hợp lệ"

#: musicbot/bot.py:3371
msgid "The queue is empty. Add some songs with a play command!"
msgstr "Danh sách chờ đang trống. Thêm một số bài hát với lệnh phát!"

#: musicbot/bot.py:3382
msgid "All songs in the queue are already in the autoplaylist."
msgstr "Tất cả bài hát trong danh sách chờ đã có trong danh sách phát tự động."

#: musicbot/bot.py:3386
#, python-format
msgid "Added %(number)d songs to the autoplaylist."
msgstr "Đã thêm %(number)d bài hát vào danh sách phát tự động."

#: musicbot/bot.py:3396
#, python-format
msgid "Added `%(url)s` to the autoplaylist."
msgstr "Đã thêm `%(url)s` vào danh sách phát tự động."

#: musicbot/bot.py:3399
msgid "This song is already in the autoplaylist."
msgstr "Bài hát này đã có trong danh sách phát tự động."

#: musicbot/bot.py:3413
#, python-format
msgid "Removed `%(url)s` from the autoplaylist."
msgstr "Đã xóa `%(url)s` khỏi danh sách phát tự động."

#: musicbot/bot.py:3416
msgid "This song is not yet in the autoplaylist."
msgstr "Bài hát này chưa có trong danh sách phát tự động."

#: musicbot/bot.py:3425
#, python-format
msgid "Loaded a fresh copy of the playlist: `%(file)s`"
msgstr "Đã tải một bản sao mới của danh sách phát: `%(file)s`"

#: musicbot/bot.py:3439
#, python-format
msgid ""
"**Current Playlist:** `%(playlist)s`**Available Playlists:**\n"
"%(names)s"
msgstr ""
"**Danh sách phát hiện tại:** `%(playlist)s`**Danh sách phát có sẵn:**\n"
"%(names)s"

#: musicbot/bot.py:3450
msgid "You must provide a playlist filename."
msgstr "Bạn phải cung cấp tên tệp danh sách phát."

#: musicbot/bot.py:3470
msgid ""
"\n"
"This playlist is new, you must add songs to save it to disk!"
msgstr ""
"\n"
"Danh sách phát này mới, bạn phải thêm bài hát để lưu nó vào đĩa!"

#: musicbot/bot.py:3475
#, python-format
msgid "The playlist for this server has been updated to: `%(name)s`%(note)s"
msgstr "Danh sách phát cho máy chủ này đã được cập nhật thành: `%(name)s`%(note)s"

#: musicbot/bot.py:3490
#, python-format
msgid "No playlist file exists with the name: `%(playlist)s`"
msgstr "Không có tệp danh sách phát nào tồn tại với tên: `%(playlist)s`"

#: musicbot/bot.py:3496
#, python-format
msgid "The playlist `%(playlist)s` has been cleared."
msgstr "Danh sách phát `%(playlist)s` đã được xóa."

#: musicbot/bot.py:3505
msgid "Generate an invite link that can be used to add this bot to another server."
msgstr "Tạo một liên kết mời có thể được sử dụng để thêm bot này vào một máy chủ khác."

#: musicbot/bot.py:3517
#, python-format
msgid ""
"Click here to add me to a discord server:\n"
"%(url)s"
msgstr ""
"Nhấp vào đây để thêm tôi vào một máy chủ discord:\n"
"%(url)s"

#: musicbot/bot.py:3523
msgid ""
"Toggle karaoke mode on or off. While enabled, only karaoke members may queue songs.\n"
"Groups with BypassKaraokeMode permission control which members are Karaoke members.\n"
msgstr ""
"Bật hoặc tắt chế độ karaoke. Khi được bật, chỉ các thành viên karaoke mới có thể xếp hàng bài hát.\n"
"Các nhóm có quyền BypassKaraokeMode kiểm soát các thành viên nào là thành viên Karaoke.\n"

#: musicbot/bot.py:3535
msgid "\\N{OK HAND SIGN} Karaoke mode is now enabled."
msgstr "\\N{OK HAND SIGN} Chế độ karaoke hiện đã được bật."

#: musicbot/bot.py:3537
msgid "\\N{OK HAND SIGN} Karaoke mode is now disabled."
msgstr "\\N{OK HAND SIGN} Chế độ karaoke hiện đã được tắt."

#: musicbot/bot.py:3560
msgid "You are not allowed to request playlists"
msgstr "Bạn không được phép yêu cầu danh sách phát"

#: musicbot/bot.py:3568
#, python-format
msgid "Playlist has too many entries (%(songs)s but max is %(max)s)"
msgstr "Danh sách phát có quá nhiều mục (%(songs)s nhưng tối đa là %(max)s)"

#: musicbot/bot.py:3579
#, python-format
msgid ""
"The playlist entries will exceed your queue limit.\n"
"There are %(songs)s in the list, and %(queued)s already in queue.\n"
"The limit is %(max)s for your group."
msgstr ""
"Các mục danh sách phát sẽ vượt quá giới hạn hàng đợi của bạn.\n"
"Có %(songs)s trong danh sách, và %(queued)s đã có trong hàng đợi.\n"
"Giới hạn là %(max)s cho nhóm của bạn."

#: musicbot/bot.py:3712
msgid "Bot was previously paused, resuming playback now."
msgstr "Bot đã được tạm dừng trước đó, đang tiếp tục phát lại bây giờ."

#: musicbot/bot.py:3721
msgid ""
"Add a song to be played in the queue. If no song is playing or paused, playback will be started.\n"
"\n"
"You may supply a URL to a video or audio file or the URL of a service supported by yt-dlp.\n"
"Playlist links will be extracted into multiple links and added to the queue.\n"
"If you enter a non-URL, the input will be used as search criteria on YouTube and the first result played.\n"
"MusicBot also supports Spotify URIs and URLs, but audio is fetched from YouTube regardless.\n"
msgstr ""
"Thêm một bài hát để phát trong hàng đợi. Nếu không có bài hát nào đang phát hoặc tạm dừng, phát lại sẽ được bắt đầu.\n"
"\n"
"Bạn có thể cung cấp một URL đến một tệp video hoặc âm thanh hoặc URL của một dịch vụ được hỗ trợ bởi yt-dlp.\n"
"Liên kết danh sách phát sẽ được trích xuất thành nhiều liên kết và thêm vào hàng đợi.\n"
"Nếu bạn nhập một không phải URL, đầu vào sẽ được sử dụng làm tiêu chí tìm kiếm trên YouTube và kết quả đầu tiên sẽ được phát.\n"
"MusicBot cũng hỗ trợ các URI và URL của Spotify, nhưng âm thanh sẽ được lấy từ YouTube bất kể.\n"

#: musicbot/bot.py:3760
msgid "Play command that shuffles playlist entries before adding them to the queue.\n"
msgstr "Lệnh phát sẽ xáo trộn các mục danh sách phát trước khi thêm chúng vào hàng đợi.\n"

#: musicbot/bot.py:3797
#, python-format
msgid "Shuffled playlist items into the queue from `%(request)s`"
msgstr "Đã xáo trộn các mục trong danh sách phát vào hàng đợi từ `%(request)s`"

#: musicbot/bot.py:3804
msgid ""
"A play command that adds the song as the next to play rather than last.\n"
"Read help for the play command for information on supported inputs.\n"
msgstr ""
"Một lệnh phát thêm bài hát vào danh sách phát tiếp theo thay vì cuối cùng.\n"
"Đọc trợ giúp cho lệnh phát để biết thông tin về các đầu vào được hỗ trợ.\n"

#: musicbot/bot.py:3839
msgid ""
"A play command which skips any current song and plays immediately.\n"
"Read help for the play command for information on supported inputs.\n"
msgstr ""
"Một lệnh phát bỏ qua bất kỳ bài hát nào hiện tại và phát ngay lập tức.\n"
"Đọc trợ giúp cho lệnh phát để biết thông tin về các đầu vào được hỗ trợ.\n"

#: musicbot/bot.py:3876
msgid ""
"Restarts the current song at the given time.\n"
"If time starts with + or - seek will be relative to current playback time.\n"
"Time should be given in seconds, fractional seconds are accepted.\n"
"Due to codec specifics in ffmpeg, this may not be accurate.\n"
msgstr ""
"Khởi động lại bài hát hiện tại tại thời điểm đã cho.\n"
"Nếu thời gian bắt đầu bằng + hoặc - thì tìm kiếm sẽ tương đối với thời gian phát lại hiện tại.\n"
"Thời gian nên được cho bằng giây, giây phân số được chấp nhận.\n"
"Do các đặc điểm của codec trong ffmpeg, điều này có thể không chính xác.\n"

#: musicbot/bot.py:3896
msgid "Cannot use seek if there is nothing playing."
msgstr "Không thể sử dụng tìm kiếm nếu không có gì đang phát."

#: musicbot/bot.py:3901
msgid "Cannot use seek on current track, it has an unknown duration."
msgstr "Không thể sử dụng tìm kiếm trên bài hát hiện tại, nó có độ dài không xác định."

#: musicbot/bot.py:3907
msgid "Seeking is not supported for streams."
msgstr "Tìm kiếm không được hỗ trợ cho các luồng."

#: musicbot/bot.py:3917
msgid "Cannot use seek without a time to position playback."
msgstr "Không thể sử dụng tìm kiếm mà không có thời gian để định vị phát lại."

#: musicbot/bot.py:3935
#, python-format
msgid "Could not convert `%(input)s` to a valid time in seconds."
msgstr "Không thể chuyển đổi `%(input)s` thành thời gian hợp lệ tính bằng giây."

#: musicbot/bot.py:3948
#, python-format
msgid "Cannot seek to `%(input)s` (`%(seconds)s` seconds) in the current track with a length of `%(progress)s / %(total)s`"
msgstr "Không thể tìm kiếm đến `%(input)s` (`%(seconds)s` giây) trong bài hát hiện tại có độ dài `%(progress)s / %(total)s`"

#: musicbot/bot.py:3972
#, python-format
msgid "Seeking to time `%(input)s` (`%(seconds).2f` seconds) in the current song."
msgstr "Đang tìm kiếm đến thời gian `%(input)s` (`%(seconds).2f` giây) trong bài hát hiện tại."

#: musicbot/bot.py:3984
msgid ""
"Toggles playlist or song looping.\n"
"If no option is provided the current song will be repeated.\n"
"If no option is provided and the song is already repeating, repeating will be turned off.\n"
msgstr ""
"Chuyển đổi giữa việc lặp lại danh sách phát hoặc bài hát.\n"
"Nếu không có tùy chọn nào được cung cấp, bài hát hiện tại sẽ được lặp lại.\n"
"Nếu không có tùy chọn nào được cung cấp và bài hát đã lặp lại, việc lặp lại sẽ bị tắt.\n"

#: musicbot/bot.py:4002
